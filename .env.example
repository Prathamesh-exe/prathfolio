# Copy to .env.local and fill in what you need.
# Every variable is optional for local development.

# Canonical site URL (metadata, sitemap, registry URLs)
APP_URL=http://localhost:1408

# Contact form — https://resend.com/api-keys
RESEND_API_KEY=

# GitHub API (optional; raises rate limits for the nav widget)
GITHUB_API_TOKEN=
# Contributions chart endpoint
GITHUB_CONTRIBUTIONS_API_URL=

# Analytics (only enabled in production builds)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
NEXT_PUBLIC_POSTHOG_UI_HOST=
NEXT_PUBLIC_OPENPANEL_CLIENT_ID=

# Misc
NEXT_PUBLIC_DMCA_URL=
REGISTRY_NAMESPACE=@prathfolio
REGISTRY_NAMESPACE_URL=http://localhost:1408/r/{name}.json
